<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Card with Hazard Tape Border</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
<div class="bg-img-container">
    <img src="img/bg-img.jpg" alt="test" class="bg-img">
</div>
<div class="card-container">
    <div class="card">
        <h2>Login</h2>
        <form
                action="/login"
                method="POST"
        >
            <div class="input-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required>
            </div>
            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button class="btn-primary" type="submit">Login</button>
        </form>
    </div>

    <div class="card">
        <h2>Help Homer waste time</h2>
        <img src="img/homer_simpson.jpeg" alt="Nuclear plant">

        <div class="homer-waste-box">
            <form action="/waste" method="POST">
                <input type="text" class="search-box" id="waste-box-search" name="url">

                <button type="submit" id="waste-box-search">
                    Go
                </button>
            </form>
        </div>
    </div>
</div>
</body>
</html>