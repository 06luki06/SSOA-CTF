<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Employee</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/employee.js" defer></script>
</head>
<body>
<div class="bg-img-container">
    <img src="/img/bg-img.jpg" alt="test" class="bg-img">
</div>
<div class="card-container">
    <div class="card" id="employeeSearch">
        <h1>Employee Search</h1>
        <form action="/employee/search" method="post">
            <div class="input-group">
                <label for="employeeName">Name</label>
                <input type="text" id="employeeName" name="employeeName" required>
            </div>
            <button type="submit" class="btn-primary">
                Search
            </button>
        </form>
    </div>
    <% if (!isAdmin) { %>
        <div class="card" id="burnsComments">
            <h1>Thoughts from colleagues</h1>
            <div id="comments-con" class="comments">

            </div>
            <div class="input-group">
                <label for="comment">Comment</label>
                <input type="text" id="comment" name="comment" required>
            </div>
            <button type="submit" class="btn-primary" id="commentBtn">
                Leave a comment
            </button>
        </div>
    <% } else { %>
    <% } %>    
</div>
</body>
</html>